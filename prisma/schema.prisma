// Prisma 7 — uses the new ESM `prisma-client` generator + a Driver Adapter
// (PrismaClient is instantiated with `@prisma/adapter-pg`, see services/db/prisma.ts).
// Datasource URL is read from prisma.config.ts (DIRECT_URL for CLI/migrations).

generator client {
  provider = "prisma-client"
  // Output inside the project (gitignored) — see AGENTS.md for the rationale.
  output   = "../services/db/generated"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Roles
// =============================================================================
// GlobalRole = platform-level. Set via SQL or an admin tool.
// FundRole   = per-fund staff access. Lives on FundMember. Demand-side
// members (recipients of allocations) are modelled separately as `Member`
// and never flow through FundMember.
//
// Fund role hierarchy (high → low): OWNER > ADMIN > VIEWER.
// Authorization comparisons live in services/auth/dal.ts.

enum GlobalRole {
  USER
  ADMIN
}

enum FundRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

// =============================================================================
// Core
// =============================================================================
//
// "Fund" (en) / "caisse" (fr) is the core unit of La Caisse. Each fund has
// exactly one canonical `domain` — for free funds it's a subdomain of the
// platform apex (e.g. `acme.lacaisse.eu`); paid funds can replace it with
// their own (e.g. `funds.acme.com`). There is no separate slug concept; the
// host IS the identity.

model User {
  // Owned by Better Auth. With `advanced.database.generateId: "uuid"` and the
  // Postgres Prisma adapter, Better Auth treats UUIDs as DB-generated and
  // omits `id` from inserts — so every Better Auth-owned table needs a DB
  // default. `gen_random_uuid()` is built into Postgres ≥13. Keeping @db.Uuid
  // on every userId FK (FundMember.userId, Member.userId, etc.) unchanged.
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique
  emailVerified Boolean    @default(false) // Better Auth core field
  name          String?
  image         String? // Better Auth core field (avatar URL)
  globalRole    GlobalRole @default(USER)

  memberships       FundMember[]
  fundInvitesSent   FundInvite[] @relation("FundInvitesSent") // staff invites this user created
  passkeys          Passkey[]
  accounts          Account[]
  sessions          Session[]
  memberRecords     Member[] // demand-side member rows linked to this auth user (rare)
  reviewedMerchants Merchant[] // merchants this admin reviewed (approved or rejected)

  // Mint/burn audit: annotations whose underlying op this user triggered.
  triggeredAnnotations        TransactionAnnotation[] @relation("AnnotationTriggeredBy")
  triggeredPendingAnnotations PendingAnnotation[]     @relation("PendingAnnotationTriggeredBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// Better Auth tables
// =============================================================================
// Schema shape is dictated by Better Auth's Prisma adapter — do not rename
// fields or change types. Plugin-specific tables (Passkey) follow the same
// rule. ID columns use Postgres-side `gen_random_uuid()` because Better Auth's
// Prisma adapter detects `supportsUUIDs` on Postgres and skips client-side id
// generation when `advanced.database.generateId: "uuid"` is set.

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @db.Uuid
  // providerId = "credential" for email+password, or the OAuth provider name
  // ("google", "github", …). accountId = the user's id on that provider
  // (or a sentinel for credential auth). password holds the bcrypt hash for
  // credential providers; null for OAuth.
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// One row per outstanding email verification / password reset / etc.
// Better Auth manages lifecycle; we just need the table to exist.
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String // email (or other identifier the verification is for)
  value      String // opaque token
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// Passkey credentials. Replaces the self-managed WebAuthnCredential model —
// Better Auth's @better-auth/passkey plugin owns this schema. Fields are
// fixed by the plugin; transports is a comma-separated string (not Postgres
// array) because Better Auth normalises it that way.
model Passkey {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String  @db.Uuid
  name         String? // user-friendly label (e.g. "iPhone Touch ID")
  publicKey    String // base64url
  credentialID String  @unique
  counter      Int
  deviceType   String // 'singleDevice' | 'multiDevice'
  backedUp     Boolean
  transports   String? // comma-separated: 'usb,nfc,ble,internal,hybrid'
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Fund {
  id     String @id @default(cuid())
  domain   String  @unique // full hostname: "acme.lacaisse.eu" or "funds.acme.com"
  name     String
  fullName String? // full / legal name, e.g. "Caisse Locale d'Alimentation Solidaire de Schaerbeek" for "La CLASS"; falls back to `name`

  // Branding (per the multi-tenant spec, 4.2)
  logoUrl      String?
  primaryColor String? // hex e.g. "#1a73e8"
  websiteUrl   String? // the fund's public website, surfaced in member-facing docs (e.g. the onboarding letter)

  // Token identity. PSD2's €1M cap is regulatory, not stored per-fund.
  // Bank-sync minting must assert these are set before running.
  tokenName   String?
  tokenSymbol String?

  // On-chain token configuration. Mint/burn run from this repo against the
  // contract at `tokenAddress` on chain `tokenChainId` (Gnosis = 100 by
  // default; chosen so the picker has a sensible value before the admin
  // touches the form). `tokenDecimals` is cached from the contract's
  // `decimals()` after the address is verified.
  //
  // The minter is an EOA (private key encrypted via APP_CRED_KEY — see
  // services/crypto/secret.ts) that signs UserOps submitted through
  // CitizenPay's bundler (`CITIZENPAY_BUNDLER_URL`). The smart-account
  // address derived from CP's factory is what actually holds MINTER_ROLE
  // on the token contract; we populate it once the factory + salt are
  // wired (TBD pending bundler docs). `tokenMintEnabledAt` is set when we
  // last verified `hasRole(MINTER_ROLE, smartAccount)` on-chain.
  tokenChainId                   Int       @default(100)
  tokenAddress                   String?
  tokenDecimals                  Int?
  tokenLogoUrl                   String?
  tokenMinterPrivateKeyEnc       String?
  tokenMinterEoaAddress          String?
  tokenMinterSmartAccountAddress String?
  tokenMintEnabledAt             DateTime?

  // Allocation mode. FIXED_PERIOD runs auto-allocations on a recurring
  // cadence (period entries live in a separate AllocationPeriod model
  // TBD); PAY_AND_GO mints immediately when CitizenPay reports a deposit.
  // Either way, the *minting* decision is ours — CP handles bank-sync
  // detection and payouts but the fund owns token issuance.
  allocationMode AllocationMode @default(FIXED_PERIOD)

  // FIXED_PERIOD only: the day-of-month at which each monthly period hits its
  // cutoff and the batch mint fires. Auto-created periods derive their
  // `cutoffDate` from this; a manually-created period can override the exact
  // date. Clamped to the month length at use (so 31 = last day of every
  // month). Ignored for PAY_AND_GO.
  allocationCutoffDay Int @default(31)

  // Referral programme (5.3.4). Null = not configured. Tokens minted to
  // the sponsor only on the referee's activation.
  referralBonusAmount Decimal? @db.Decimal(10, 2)

  // Platform fee taken on merchant payments, as a percent (e.g. "2.50" =
  // 2.5%). Null = not configured (CP applies its own default). We are
  // canonical: the settings UI persists this locally first, then pushes the
  // value (as integer basis points) to CP via PATCH /v2/treasury.
  // `payoutFeeSynced` is false while a local change hasn't yet been accepted
  // by CP (DB may lead CP) — the UI surfaces a retry hint. Per-business
  // overrides are future work.
  payoutFeePercentage Decimal? @db.Decimal(5, 2)
  payoutFeeSynced     Boolean  @default(true)

  // Defaults
  defaultLocale String @default("fr")
  timezone      String @default("Europe/Brussels")

  // CitizenPay linkage. `citizenPayFundId` is null until connected. The
  // sync timestamp lets the admin UI surface "last seen" / staleness;
  // "connected" is derived as `id != null && lastSyncedAt > threshold`.
  //
  // Per-fund API credentials. `citizenPayApiKeyId` is the API key ID
  // (Ethereum address, not sensitive on its own) stored plaintext.
  // `citizenPayApiKeyEnc` is the paired secret, AES-256-GCM encrypted with
  // CITIZENPAY_CRED_KEY — see services/citizenpay/crypto.ts. Set via the
  // `scripts/encrypt-cp-secret.mjs` helper + SQL until an admin UI exists.
  citizenPayFundId          String?
  citizenPayApiKeyId        String?
  citizenPayApiKeyEnc       String?
  citizenPayApiKeyUpdatedAt DateTime? // last successful pickup-and-write
  citizenPayLastSyncedAt    DateTime?
  // CP treasury slug, cached from `GET /v2/treasury` (the `network` segment of
  // a card's public tap URL: https://tap.citizenpay.xyz/card/<serial>?network=<slug>).
  // Refreshed whenever the API key is (re)issued — see services/citizenpay/sync.ts.
  citizenPayTreasurySlug String?

  // 4337 stack identity. Cached from CP's `GET /v2/treasury` response —
  // CP picks the entrypoint / factory / paymaster per treasury and we
  // shouldn't second-guess. `paymasterType` is the classifier passed in
  // `pm_ooSponsorUserOperation` params (e.g. "cw-safe"). All four are
  // refreshed every time the API key is (re)issued — see
  // services/citizenpay/sync.ts.
  citizenPayEntrypointAddress     String?
  citizenPayAccountFactoryAddress String?
  citizenPayPaymasterAddress      String?
  citizenPayPaymasterType         String?

  // Legal — links out to the fund's own ToS / privacy pages.
  termsUrl   String?
  privacyUrl String?

  // Email verification toggles. When true, public signups must confirm
  // their email before the application enters the admin review queue.
  // Defaults to true; admins can disable per tenant if their flow doesn't
  // need it (e.g. closed-network funds where applicants are pre-vetted).
  requireMemberEmailVerification   Boolean @default(true)
  requireMerchantEmailVerification Boolean @default(true)

  // When set, member-facing confirmation emails (PAYMENT_CONFIRMATION at
  // bank-sync ingest, ALLOCATION_CONFIRMATION when a sourced mint confirms)
  // are skipped — not queued: resuming does not send them retroactively.
  // Other emails (invites, verification, referral bonus) are unaffected.
  confirmationEmailsPausedAt DateTime?

  // Custom From address for member-facing transactional emails (verification,
  // welcome, activation, invitation, payment + allocation confirmation,
  // referral bonus). Stored as a bare address; the display name is the fund
  // name at send time ("<fund.name> <senderEmail>"). When null, sends fall
  // back to the platform EMAIL_FROM. Merchant/team emails and Supabase auth
  // emails are NOT affected. The domain must be verified in Resend or the
  // send fails.
  senderEmail String?

  // Post-signup redirect URLs. When set, the last step of a successful
  // signup flow (form submit if no verification, otherwise the email-verify
  // landing) sends the visitor to this URL instead of the in-app /thanks
  // page. Funds with their own marketing site use this to keep the visitor
  // on-site after applying.
  memberSignupSuccessUrl   String?
  merchantSignupSuccessUrl String?

  staff              FundMember[] // staff with admin access (OWNER/ADMIN/VIEWER)
  invites            FundInvite[] // pending staff invitations
  members            Member[] // demand-side recipients of allocations
  cards              Card[] // cards in the fund (may be member-bound or imported)
  tiers              AllocationTier[] // contribution/allocation tiers
  merchants          Merchant[] // shops in the fund's network
  onboardingFields   OnboardingField[] // per-fund extras on the signup forms
  bankTransactions   BankTransaction[] // bank-sync mirror (incoming + outgoing)
  tokenOperations    TokenOperation[] // mint/burn/transfer audit log
  allocationPeriods  AllocationPeriod[] // FIXED_PERIOD scheduling windows
  linkedBankAccounts LinkedBankAccount[] // learned IBAN → member mappings
  referrals          Referral[] // referral programme records (5.3.4)
  emails             Email[] // transactional email outbox/log
  emailTemplates     EmailTemplate[] // per-fund overrides of the default email wording
  documentTemplates  DocumentTemplate[] // per-fund overrides of printable document wording (PDF letters)

  citizenPayConnectAttempts CitizenPayConnectAttempt[] // in-flight CP connect handoffs
  addressProfiles           AddressProfileCache[] // CP profile cache (token explorer / transfers)
  tokenAccounts             FundTokenAccount[] // named smart accounts (minter EOA + salt)
  txAnnotations             TransactionAnnotation[] // per-tx labels for on-chain history
  pendingAnnotations        PendingAnnotation[] // userOp hashes awaiting tx-hash resolution

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AllocationMode {
  FIXED_PERIOD // attribute tokens at the end of each period (monthly etc.)
  PAY_AND_GO // mint immediately when CP reports a deposit
  DISABLED // no automatic allocation: deposits are still mirrored/matched, but no minting and no periods
}

// Per-fund annotation of an on-chain transaction, keyed by tx hash. Lets us
// label what a transaction was for (e.g. a payout fee sweep, an account
// transfer) so transaction-history views can show meaning next to the raw
// hash. `kind` is a machine category resolved to a localised label in the UI;
// `note` is optional free text (custom annotations). Written best-effort by the
// actions that produce the tx — never the source of truth for the tx itself.
model TransactionAnnotation {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  txHash String // on-chain tx hash, stored lowercased
  kind   String // machine category (PAYOUT_FEE, ACCOUNT_MINT, …)
  note   String? // optional free-text detail / custom annotation

  // Mint/burn audit (immutable, set at creation — distinct from the
  // operator-editable kind/note). `trigger` is the system origin of the op
  // (ANNOTATION_TRIGGERS); `triggeredByUserId` is the acting admin, NULL for
  // system/cron-driven ops (bank-sync, period-close). Both NULL on pre-audit
  // historical rows.
  trigger           String?
  triggeredByUserId String? @db.Uuid
  triggeredBy       User?   @relation("AnnotationTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, txHash])
  @@index([fundId])
  @@index([triggeredByUserId])
}

// A userOp hash awaiting resolution to its settlement tx hash, so we can write
// a TransactionAnnotation keyed by the REAL tx hash (the one on-chain history
// shows) rather than the userOp hash. CP returns userOp hashes for the payout
// fee sweep; we queue them here and a cron polls the bundler
// (`GET /v1/{chainId}/userop/{hash}/tx`) until `success` (→ annotate + drop) or
// `reverted` / `timeout` / attempts exhausted (→ drop). Non-blocking by design.
model PendingAnnotation {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  chainId    Int
  userOpHash String // bundler userOp hash, stored lowercased
  kind       String // annotation kind to apply once resolved
  note       String? // optional note to carry onto the final annotation
  attempts   Int     @default(0) // poll count — capped so we don't loop forever

  // Carried onto the resolved TransactionAnnotation (see that model).
  trigger           String?
  triggeredByUserId String? @db.Uuid
  triggeredBy       User?   @relation("PendingAnnotationTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, userOpHash])
  @@index([fundId])
  @@index([triggeredByUserId])
}

// A named, fund-owned smart account. Counterfactually derived (CREATE2) from
// the fund's minter EOA (`Fund.tokenMinterEoaAddress`) against CP's Safe
// factory (`Fund.citizenPayAccountFactoryAddress`) with a per-fund-unique
// `saltNonce`. Salt 0 is reserved for the minter's own account
// (`Fund.tokenMinterSmartAccountAddress`), so these start at 1. `address` is
// the cached derived address; balances + transfer history are read on-chain
// via Alchemy. Archived rows stay for history but drop out of the list.
enum FundTokenAccountKind {
  STANDARD // ordinary minter-derived Safe — supports transfer/mint/burn
  SOURCE // referenceable as a card source (has a `serial`); not transferable
}

model FundTokenAccount {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  name      String // operator-facing label
  saltNonce Int // unique per fund; salt 0 is the minter, so these are ≥ 1
  address   String // counterfactual Safe address (deterministic across chains)

  kind FundTokenAccountKind @default(STANDARD)

  // Set only for SOURCE accounts: a text serial we can hand to CitizenPay so the
  // account is referenceable as a card's pull-from source (CP keys sources by
  // serial). Deliberately formatted to never collide with an NFC UUID — see
  // services/token-account/serial.ts. Globally unique because CP's serial
  // namespace is global; NULL for STANDARD accounts (Postgres NULLs are
  // distinct, so any number of them coexist).
  serial String? @unique

  archivedAt DateTime? // soft delete — hidden from the list, kept for history
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([fundId, saltNonce])
  @@unique([fundId, address])
  @@index([fundId])
}

model FundMember {
  id     String   @id @default(cuid())
  userId String   @db.Uuid
  fundId String
  role   FundRole @default(VIEWER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fundId])
  @@index([fundId])
}

// A pending invitation for someone to become fund *staff* (a FundMember).
// Keyed by email because the invitee may not have a User account yet —
// Better Auth only creates the User row at signup, and FundMember.userId is
// a hard FK, so we can't pre-create the membership. The invite is
// materialized into a FundMember when the invitee signs in/up with the
// matching email and accepts (see services/fund-team). One pending invite
// per (fund, email); re-inviting replaces it with a fresh token.
model FundInvite {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  email String // normalized lowercase
  role  FundRole // OWNER | ADMIN granted on accept (VIEWER unused here)
  token String   @unique // random, carried in the accept URL

  invitedById String @db.Uuid
  invitedBy   User   @relation("FundInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?   @db.Uuid // User who accepted (audit; no FK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, email])
  @@index([fundId])
}

// =============================================================================
// Members & cards
// =============================================================================
// A `Member` is the demand-side recipient — the person who receives token
// allocations and carries one or more physical cards. Distinct from
// `FundMember`, which captures *staff* access (OWNER/ADMIN/VIEWER).
//
// CitizenPay does not store members; identity lives entirely with us. Cards
// are the linkage point: each card's `serialNumber` is the NFC UUID
// CitizenPay uses to refer to it (e.g. "040039AA1D1291"), and each card has
// its own on-chain `account`. The member's primary card holds the funds;
// secondary cards spend from it via CitizenPay-side delegation we don't
// model here.

model Member {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  // Identity (CitizenPay never sees these — only we do)
  email     String
  firstName String
  lastName  String
  phone     String?

  // Preferred language, captured from the request locale at self-signup so
  // every email we send them is in the language they registered in. Null for
  // admin-created / imported members (preference unknown) — the email layer
  // then falls back to the fund's default locale. A supported-locale code
  // (e.g. "fr", "en"); see services/i18n/config.ts.
  locale String?

  // Optional auth link — set only when the member self-onboards via login.
  // Most members are created by admins from paper forms and never log in.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Address (reporting + printed correspondence)
  address    String?
  postalCode String?
  city       String?

  // Household composition — input to tier assignment
  householdAdults   Int @default(1)
  householdChildren Int @default(0)

  // Banking. `paymentReference` is the string the member writes on their
  // bank transfer; bank-sync matches contributions by it. Per-fund unique.
  // Generated in the create action — Prisma can't default this from a fn.
  iban             String?
  paymentReference String?

  // Tier assignment — drives the auto-allocation amount on bank-sync. La
  // CLASS (and other funds) determine the right tier for a member from
  // their own external data; we only store the assignment.
  tierId String?
  tier   AllocationTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  // Responses to per-fund custom onboarding fields. Built-in fields
  // (firstName/lastName/email for members) are written to their typed
  // columns; everything else lives here, keyed by OnboardingField.key.
  applicationData Json?

  // Lifecycle
  status   MemberStatus @default(NEW)
  joinedAt DateTime     @default(now())
  leftAt   DateTime?

  notes String?

  // Cards: many-to-one inverse, plus a single nullable primary pointer.
  // SetNull on primary so deleting a card (rare — we usually block, not
  // delete) leaves the member intact with no primary.
  cards         Card[]  @relation("MemberCards")
  primaryCardId String? @unique
  primaryCard   Card?   @relation("MemberPrimaryCard", fields: [primaryCardId], references: [id], onDelete: SetNull)

  // Linked deposits and the mint/burn ops they triggered.
  bankTransactions BankTransaction[]
  tokenOperations  TokenOperation[]

  // Learned bank accounts that auto-match deposits to this member.
  linkedBankAccounts LinkedBankAccount[]

  // Permanent referral code shared by this member with prospective new
  // members. App-side generator produces URL-safe chars (alphanumeric, no
  // ambiguous 0/O/1/l). Per-fund unique. NULL until the member is created.
  referralCode String?

  // Sponsor relationships: this member has referred N others. Referee
  // relationship: at most one row (this member was referred by someone).
  sponsoredReferrals Referral[] @relation("ReferralSponsor")
  referralRecord     Referral?  @relation("ReferralReferee")

  // Master unsubscribe. Reminders and other non-essential emails are skipped
  // when this is true. Per-type preferences can come later via a separate
  // MemberEmailPreference model if demand surfaces.
  emailUnsubscribed   Boolean   @default(false)
  emailUnsubscribedAt DateTime?

  // Email verification — same shape as Merchant. NULL means unverified;
  // gated by Fund.requireMemberEmailVerification.
  emailVerifiedAt DateTime?

  emailVerifications EmailVerification[]

  // Transactional emails this member is the recipient of.
  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, email])
  @@unique([fundId, paymentReference])
  @@unique([fundId, referralCode])
  @@index([fundId, status])
  @@index([userId])
}

enum MemberStatus {
  NEW // signed up / added, not active yet (was INVITED + ONBOARDING)
  ACTIVE // participating — the only status that receives allocations + emails
  INACTIVE // not participating, kept on file
  PAUSED // temporarily paused
  STOPPED // actively stopped / resigned (was LEFT)
  REJECTED // signed up, won't be activated
}

model Card {
  id String @id @default(cuid())

  // Fund scoping is direct (rather than via Member) so cards can exist
  // without an owning member — e.g. cards imported from CitizenPay before
  // being attached to a holder. Most cards are member-bound (created via
  // member activation or addCard), but the import flow on /cards/sync
  // creates them unattached.
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  // Optional member binding. Null for imported / unattached cards.
  memberId String?
  member   Member? @relation("MemberCards", fields: [memberId], references: [id], onDelete: SetNull)

  // CitizenPay linkage. `serialNumber` is the NFC UUID (printed/scannable
  // on the physical card) — admin enters this at activation time. `account`
  // is the on-chain wallet address, populated when CitizenPay registers
  // the card; nullable until then so admin can create the local row before
  // the CP roundtrip completes.
  serialNumber String  @unique
  account      String? @unique

  // Per-fund sequential card number (1…N). Encoded in the Belgian structured
  // communication members put on their bank transfers (base of the OGM =
  // this number), so bank-sync can match a deposit to the card. Auto-assigned
  // (max+1 per fund) at creation, admin-editable, importable via CSV. Nullable
  // for cards created before numbering / not yet assigned.
  number Int?

  // Typically the dependant's name on a secondary card; on the primary it
  // mirrors the member.
  holderName String?

  // CitizenPay-reported status — drives whether the terminal accepts charges.
  status CardStatus @default(INACTIVE)

  // Mirror of CP's `source_serial`: the card this card pulls from when its
  // own balance can't cover a charge. CP is authoritative (set via the card
  // detail page, healed during card sync); display cache only — charge-time
  // behaviour never reads this. A serial string (not an FK) so a source that
  // exists on CP but not locally is still representable.
  sourceSerial String?

  // Internal flag, doesn't change terminal behaviour. Usually paired with a
  // status change to BLOCKED at CitizenPay when the holder reports a loss.
  reportedLostAt DateTime?

  // Cached from CitizenPay for sorting/filtering — source of truth is the API.
  balance           Decimal?  @db.Decimal(12, 2)
  lastTransactionAt DateTime?

  // Last time we pushed/refreshed the card's public profile via CitizenPay.
  profileSyncedAt DateTime?

  issuedAt  DateTime?
  blockedAt DateTime?

  // Inverse of Member.primaryCard (one-to-one).
  primaryOf Member? @relation("MemberPrimaryCard")

  // Bank deposits whose reference resolved to this card (serial / structured
  // communication match). The mint for such a deposit targets this card.
  bankTransactions BankTransaction[]

  // Emails about this card (e.g. the CARD_ASSIGNED "your card is on its way"
  // notification). The notify status on the card detail page reads these.
  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, number])
  @@index([memberId])
  @@index([fundId])
  @@index([status])
}

enum CardStatus {
  ACTIVE // in use; a card flips here automatically on its first charge
  INACTIVE // factory default — not charged yet; does NOT block the card
  BLOCKED // terminal will refuse
}

// =============================================================================
// Allocation tiers
// =============================================================================
// Each fund defines its own tiers (paliers). Members are assigned to one tier;
// when bank-sync detects a deposit from that member of at least
// minContribution, it mints `allocationAmount` worth of tokens to the member's
// primary card (paying above maxContribution still allocates — generosity is
// welcome). Tiers are soft-deleted (archivedAt) so historical assignments
// remain valid for reporting.

// =============================================================================
// Merchants
// =============================================================================
// A `Merchant` is a shop in a fund's accepting network. Per-fund row even
// when the same physical business serves multiple funds — each fund signs
// its own conventions and runs its own verification.
//
// The merchant connects with CitizenPay separately and gets a business id
// + one or more places (CP places can accept tokens from multiple funds at
// once). We only cache the `placeId` we need for THIS fund and CP's
// activation flag for it.

model Merchant {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  // Public identity (shown in the merchant directory)
  name        String
  description String?
  logoUrl     String?
  website     String?

  // Per-fund acceptance conditions — free-form so each fund can express
  // its own rules ("fresh produce only", "min purchase €5") without a
  // schema change.
  conditions String?

  // Contact
  contactName String?
  email       String?
  phone       String?

  // Postal address — kept for printed correspondence and the directory.
  // Once the merchant connects on CitizenPay, the place row carries the
  // canonical address + geo-coordinates; we cache them here so the
  // directory + map don't need a CP round-trip per render.
  address    String?
  postalCode String?
  city       String?
  country    String?
  // PostgreSQL DOUBLE PRECISION — sub-meter accuracy is overkill for
  // displaying a merchant pin. Null until CP reports them.
  latitude   Float?
  longitude  Float?

  // CitizenPay linkage. `placeId` is null until the merchant connects.
  // Per-fund unique (within one fund a place maps to one merchant), but
  // the same `placeId` may appear under multiple funds — places in CP
  // can accept tokens from any fund the merchant has signed with.
  //
  // `businessId` is CP's parent identifier (a business has 1..N places).
  // We cache it on every place row so the "disconnect" action — which
  // hits a business-level endpoint and tears down ALL places of that
  // business — can find sibling Merchant rows in the same fund without
  // a round trip to CP.
  //
  // `placeAccount` is the on-chain wallet CP issued for the place.
  // Cached so we can resolve "this address → which merchant" (token
  // explorer, transfer labels) without re-listing places against CP on
  // every render. May be null between place-create and account-issue on
  // CP's side.
  citizenPayPlaceId      String?
  citizenPayBusinessId   String?
  citizenPayPlaceAccount String?
  citizenPayActivatedAt  DateTime? // CP-confirmed activation for this fund
  citizenPayLastSyncedAt DateTime? // last poll against CP

  // In-flight invite tracking. CP keys invites by (treasury, email) and
  // auto-rejects a prior pending invite when a new one is minted for the
  // same pair — so we only ever need to track ONE invite per merchant,
  // not a separate table. Fields are cleared once the callback lands
  // (accepted → citizenPayBusinessId is set; rejected → cleared without
  // a businessId).
  citizenPayInviteToken     String?
  citizenPayInviteEmail     String? // email actually sent the invite (may differ from current Merchant.email after edits)
  citizenPayInviteSentAt    DateTime?
  citizenPayInviteExpiresAt DateTime?

  // Lifecycle. Single intake: every merchant starts at PENDING — admin-
  // initiated adds also go through this state, the admin just immediately
  // approves themselves in the same UI. REJECTED is non-terminal; an admin
  // can move it back to PENDING for reconsideration.
  status MerchantStatus @default(PENDING)

  // Email verification. Public signups need to confirm their email before
  // the application enters the admin review queue. Set when a verification
  // token is consumed. Admin direct-adds can populate this immediately
  // since the admin already vouches. Gated by
  // Fund.requireMerchantEmailVerification.
  emailVerifiedAt DateTime?

  emailVerifications EmailVerification[]

  // Application payload. Free-form JSON so the per-fund onboarding form
  // can collect whatever custom fields each fund needs without a schema
  // change. Structure is owned by services/merchant/onboarding.ts (TBD).
  applicationData Json?

  // Review audit — set when an admin moves the row out of PENDING. The
  // same fields are reused on REJECTED → PENDING → ACTIVE: we overwrite
  // with the latest review since that's the one that matters.
  reviewedAt DateTime?
  reviewerId String?   @db.Uuid
  reviewer   User?     @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote String?

  joinedAt DateTime @default(now())

  notes String?

  // Display order in the directory (lower first).
  position Int @default(0)

  // Public-directory visibility. When false the merchant is hidden from
  // public-facing surfaces — the {shopList} email variable today, the
  // public directory/map later. Independent of `status`: an ACTIVE
  // merchant can be temporarily hidden without archiving. Defaults to
  // visible so existing rows stay listed.
  publiclyVisible Boolean @default(true)

  // Outgoing bank transactions matched to this merchant (payouts).
  bankTransactions BankTransaction[]

  // Transactional emails this merchant is the recipient of.
  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, name])
  @@unique([fundId, citizenPayPlaceId])
  // Callback looks up the merchant by the CP-issued token. Token is
  // globally unique on CP's side, but we scope by fund as a guard — a
  // token from another fund's treasury hitting this fund's callback
  // shouldn't match.
  @@unique([fundId, citizenPayInviteToken])
  @@index([fundId, status])
  @@index([fundId, citizenPayBusinessId])
  @@index([fundId, citizenPayPlaceAccount])
}

enum MerchantStatus {
  PENDING // signup submitted, awaiting admin review
  ACTIVE // approved by fund admin (CP activation tracked separately)
  INACTIVE // paused (was active, can be reactivated)
  REJECTED // admin rejected — can be moved back to PENDING for reconsideration
}

// One row per outstanding verification attempt — polymorphic over Member
// and Merchant. Exactly one of `memberId` / `merchantId` is set per row
// (enforced app-side; Prisma can't express it). Resending generates a new
// row; older unconsumed rows remain readable for audit. The email snapshot
// invalidates the token if the entity's address changes between issue and
// click.
model EmailVerification {
  token String @id // base64url, 32 bytes

  memberId   String?
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  email String

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([memberId])
  @@index([merchantId])
  @@index([expiresAt])
}

// =============================================================================
// Onboarding form (per-fund custom extras)
// =============================================================================
// Built-in form fields are hardcoded in the signup UI:
//   Member:   firstName, lastName, email
//   Merchant: name, description, address, postalCode, city, country, logoUrl,
//             contactName, email, phone
// Their values land on the typed columns of Member/Merchant.
//
// `OnboardingField` rows are the per-fund EXTRAS appended to that hardcoded
// form. Their responses are stored on `Member.applicationData` /
// `Merchant.applicationData`, keyed by the field's `key`.

model OnboardingField {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  target OnboardingTarget

  // Stable JSON key for `applicationData`. Once set, changing it would
  // orphan historical answers — admin UI prevents editing.
  key String

  type     OnboardingFieldType
  label    String // shown to the applicant
  helpText String?

  required Boolean @default(false)
  position Int     @default(0)

  // Type-specific config validated app-side, e.g.
  //   SELECT/MULTISELECT: { "options": [{ value, label }] }
  //   NUMBER:             { "min": 1, "max": 100, "step": 0.5 }
  //   TEXT/TEXTAREA:      { "minLength": 1, "maxLength": 500, "pattern": "..." }
  //   DATE:               { "minDate": "...", "maxDate": "..." }
  config Json?

  // Soft-delete: archived fields don't appear in new forms but historical
  // applicationData referencing the field's key keeps its context.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, target, key])
  @@index([fundId, target])
}

enum OnboardingTarget {
  MEMBER
  MERCHANT
}

enum OnboardingFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  SELECT
  MULTISELECT
  CHECKBOX
  DATE
}

model AllocationTier {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  name String // e.g. "Standard", "Solidaire", "Familial"

  // Contribution band. A deposit of at least minContribution earns the
  // allocation; maxContribution is the tier's indicative upper bound (a
  // deposit above it STILL allocates — only below-minimum is excluded).
  minContribution Decimal @db.Decimal(10, 2)
  maxContribution Decimal @db.Decimal(10, 2)

  // Tokens minted when a contribution is detected (the doc's "montant cible").
  // Independent of the deposit amount — a fund subsidises the difference.
  allocationAmount Decimal @db.Decimal(10, 2)

  // Display order in the admin UI. Lower = first.
  position Int @default(0)

  // Soft-delete: archived tiers can't be assigned to new members but
  // existing assignments remain so historical reporting still works.
  archivedAt DateTime?

  members         Member[]
  tokenOperations TokenOperation[] // mint ops driven by this tier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, name])
  @@index([fundId])
}

// =============================================================================
// Cross-host login exchange (Google-style auth handoff)
// =============================================================================
// Auth lives on `auth.lacaisse.eu`. After login, the auth host mints a single-
// use code bound to a target host (a fund subdomain, custom domain, or apex)
// and redirects the user to `<target>/auth/handoff?code=…`. The handoff route
// consumes the code and writes Supabase session cookies for *that* host.
// See services/auth/exchange.ts.

model AuthExchange {
  code       String    @id // 32 bytes, base64url
  userId     String    @db.Uuid
  email      String // snapshot — avoids a User lookup on consume
  targetHost String // exact hostname the code is valid for
  createdAt  DateTime  @default(now())
  expiresAt  DateTime // ~30s after createdAt
  consumedAt DateTime? // single-use; set atomically on consume

  @@index([expiresAt])
}

// =============================================================================
// CitizenPay connect (treasury creation handoff)
// =============================================================================
// The admin initiates a "Connect to CitizenPay" flow from fund settings; we
// redirect to CitizenPay with a random `state` token, they create the
// treasury, and they redirect back with `?state=…&pickup=…`. The callback
// route verifies `state` against this row, then GETs CP's pickup endpoint
// once to receive {apiKey, apiKeyId, treasuryId} and writes them onto the
// Fund. `consumedAt` makes the row single-use so a leaked redirect URL
// can't be replayed. `returnHost` snapshots the host we asked CP to redirect
// to (defence in depth — if CP returns to a different host it's rejected).
//
// Cleaned up by app/api/cron/auth-exchange-cleanup (which sweeps both
// tables on the same schedule).

model CitizenPayConnectAttempt {
  state      String    @id // 32 bytes, base64url
  fundId     String
  fund       Fund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  returnHost String // exact hostname we asked CP to redirect back to
  createdAt  DateTime  @default(now())
  expiresAt  DateTime // ~10 min after createdAt
  consumedAt DateTime? // single-use; set atomically on callback

  @@index([fundId])
  @@index([expiresAt])
}

// =============================================================================
// Address → profile cache
// =============================================================================
// Three-tier resolver feeds external addresses (anything that isn't a local
// Card.account or Merchant.citizenPayPlaceAccount) into CitizenPay's batch
// /v2/treasury/profiles endpoint. We persist the result so the hot path —
// rendering a list of transfers — doesn't re-hit CP on every render.
//
// Scoping is per-fund: CP credentials are per-fund, and CP's profile
// visibility may be scoped to the calling treasury.
//
// `notFound` is the negative cache: CP returned 404 for this address.
// Resolver TTL distinguishes hits (24h) from misses (1h) so a newly-
// registered profile appears promptly in the directory.

model AddressProfileCache {
  fundId  String
  fund    Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)
  // Lowercased 0x address. Lowercasing is enforced on write everywhere it
  // matters (CP also normalises on its side).
  address String

  name        String?
  username    String?
  description String?
  image       String?
  imageMedium String?
  imageSmall  String?
  parent      String?

  notFound  Boolean  @default(false)
  fetchedAt DateTime @default(now())

  @@id([fundId, address])
  @@index([fundId, fetchedAt])
}

// =============================================================================
// Passkeys (self-implemented since Supabase Auth has no native WebAuthn)
// =============================================================================
// Populated by /api/webauthn/register/verify; consulted by
// /api/webauthn/authenticate/{options,verify}. See services/auth/webauthn.ts.

// =============================================================================
// Bank-sync & minting
// =============================================================================
// CitizenPay handles bank-sync detection and merchant payouts, but the fund
// owns the minting decision. We mirror each bank movement locally so we can
// idempotently match deposits to members, surface them in the admin UI, and
// keep an audit trail of what we minted in response.

model BankTransaction {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  // CP's identifier — per-fund unique so a CP replay doesn't double-mint.
  externalId String

  direction TransactionDirection
  amount    Decimal              @db.Decimal(12, 2)
  currency  String               @default("EUR")

  occurredAt DateTime // value date

  // Counterpart info from the bank
  counterpartName      String?
  counterpartIban      String?
  counterpartReference String? // structured ref ("communication structurée")
  remittanceInfo       String? // free text on the transfer

  // Match. INCOMING → memberId; OUTGOING → merchantId. Set by bank-sync
  // logic; admins can manually link / re-link from the UI.
  memberId   String?
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  matchedAt  DateTime?

  // How the INCOMING deposit was matched to its member. NULL while unmatched
  // (awaiting manual attribution). SERIAL / STRUCTURED_COMMUNICATION resolve a
  // specific card (see `card`); IBAN / MANUAL resolve only the member.
  matchMethod BankMatchMethod?

  // The specific card a serial / structured-communication reference resolved
  // to — the mint target for that deposit. NULL for IBAN/MANUAL matches (which
  // mint to the member's primary card) and for unmatched rows.
  cardId String?
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)

  // For FIXED_PERIOD funds: the period this deposit accumulates into.
  // NULL for PAY_AND_GO and for unmatched OUTGOING transactions.
  allocationPeriodId String?
  allocationPeriod   AllocationPeriod? @relation(fields: [allocationPeriodId], references: [id], onDelete: SetNull)

  // Raw payload from CP for debugging and re-matching attempts.
  rawData Json?

  notes String? // admin annotations

  // Linked mint/burn/transfer ops via the join table. M:N because (a) one
  // mint can attribute to multiple deposits (member paid in two parts) and
  // (b) one deposit can drive multiple ops (failed + retry).
  operationSources TokenOperationSource[]

  // Transactional emails referencing this transaction (e.g. payment
  // confirmation).
  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, externalId])
  @@index([fundId, occurredAt])
  @@index([memberId])
  @@index([merchantId])
  @@index([cardId])
}

enum TransactionDirection {
  INCOMING // member deposit / contribution
  OUTGOING // payout to a merchant
}

// How bank-sync matched an INCOMING deposit to a member. Precedence order:
// SERIAL → STRUCTURED_COMMUNICATION → IBAN → (else unmatched → MANUAL). NAME
// matching is not stored: it only ranks suggestions in the attribution UI.
enum BankMatchMethod {
  SERIAL // card NFC serial in the reference (definite)
  STRUCTURED_COMMUNICATION // Belgian OGM, base = card number (definite)
  IBAN // counterpart IBAN known for a member (auto)
  MANUAL // admin attributed it in the review queue
}

// Learned IBAN → member mapping, per fund. Seeded from Member.iban and grown
// by manual attribution: once a deposit from an unknown account is attributed
// to a member, that account auto-matches next time (BankMatchMethod.IBAN).
// One IBAN maps to at most one member within a fund.
model LinkedBankAccount {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  iban String

  // How this mapping was established: onboarding (Member.iban seed) or a
  // manual attribution in the bank review queue.
  source LinkedBankAccountSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, iban])
  @@index([memberId])
}

enum LinkedBankAccountSource {
  ONBOARDING // seeded from Member.iban
  MANUAL // learned from a manual attribution
}

model TokenOperation {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  type TokenOperationType

  // For MINT: the recipient member. NULL for platform-level ops or if the
  // member is later deleted (we keep the audit row).
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  // CP wallet address that received the tokens. Snapshot at submission —
  // immutable even if the underlying Card is later deleted.
  account String

  // Positive amount; sign is implied by `type`.
  amount Decimal @db.Decimal(12, 2)

  // Tier that drove this MINT (snapshot of the member's tier at op time).
  // SetNull on tier delete — tiers are soft-deleted in practice so the
  // link normally survives.
  tierId String?
  tier   AllocationTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  // For FIXED_PERIOD funds: the period this op was batched into.
  // NULL for PAY_AND_GO and for ops outside the period flow.
  allocationPeriodId String?
  allocationPeriod   AllocationPeriod? @relation(fields: [allocationPeriodId], references: [id], onDelete: SetNull)

  // CP-side execution state. PENDING → CONFIRMED / FAILED. A polling job
  // moves PENDING ops to FAILED if the on-chain tx hash isn't confirmed
  // within a timeout. Retries create a new TokenOperation row.
  status       TokenOperationStatus @default(PENDING)
  txHash       String?              @unique // blockchain tx hash from CP
  errorMessage String?

  submittedAt DateTime  @default(now())
  confirmedAt DateTime?

  // Source bank transactions that triggered this op (M:N).
  sources TokenOperationSource[]

  // Inverse of Referral.rewardOperation — set when this MINT is the
  // payout for a referral activation.
  referral Referral?

  // Transactional emails referencing this op (e.g. allocation confirmation).
  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fundId, status])
  @@index([memberId])
  @@index([tierId])
}

enum TokenOperationType {
  MINT // create new tokens for a member's primary card
  BURN // destroy tokens (e.g. correction)
  TRANSFER // move tokens between accounts
}

enum TokenOperationStatus {
  PENDING // submitted to CP, awaiting confirmation
  CONFIRMED // CP confirmed the on-chain operation
  FAILED // CP rejected or the on-chain tx didn't confirm in time
}

// =============================================================================
// Allocation periods (FIXED_PERIOD mode)
// =============================================================================
// Deposits accumulate within a period; tokens are batch-minted at the cutoff.
// A period is one calendar month (label "YYYY-MM"). The close cron mints at
// cutoff, marks the period CLOSED, and ensures the next month's period exists
// (services/allocation-periods). PAY_AND_GO funds don't use periods at all —
// their BankTransaction / TokenOperation rows carry NULL allocationPeriodId.

model AllocationPeriod {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  // Human-readable label, per-fund unique (e.g. "2026-05").
  label String

  // Window. `cutoffDate` is the deadline for deposits to count towards this
  // period — after it, the close cron marks the period CLOSED and the batch
  // mint runs. Derived from Fund.allocationCutoffDay for auto-created periods.
  startsAt   DateTime
  cutoffDate DateTime

  // Set when the period actually finishes minting. NULL until then.
  closedAt DateTime?

  status AllocationPeriodStatus @default(OPEN)

  notes String?

  bankTransactions BankTransaction[]
  tokenOperations  TokenOperation[]
  emails           Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, label])
  @@index([fundId, status])
  @@index([fundId, cutoffDate])
}

enum AllocationPeriodStatus {
  OPEN // accepting deposits
  IN_PROGRESS // cutoff hit, minting in flight
  CLOSED // minting complete
}

// =============================================================================
// Referrals (5.3.4)
// =============================================================================
// A member shares their permanent `referralCode` with prospective new members.
// When the referee signs up using the code and later activates
// (MemberStatus → ACTIVE), the sponsor's primary card receives the fund's
// configured `referralBonusAmount` via a MINT TokenOperation.
//
// Codes are member-level (one permanent code per sponsor, reusable by many
// referees), not invitation-level (single-use).

model Referral {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  sponsorId String
  sponsor   Member @relation("ReferralSponsor", fields: [sponsorId], references: [id], onDelete: Cascade)

  refereeId String @unique
  referee   Member @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  // Snapshot of the code as it existed at signup. The sponsor's current
  // referralCode might be regenerated later; this preserves the audit.
  codeUsed String

  status      ReferralStatus @default(PENDING)
  activatedAt DateTime?

  // MINT op that paid out the sponsor (set when status → ACTIVATED). If a
  // payout mint fails and is retried, this points to the latest op; failed
  // ops sit orphaned with status=FAILED.
  rewardOperationId String?         @unique
  rewardOperation   TokenOperation? @relation(fields: [rewardOperationId], references: [id], onDelete: SetNull)

  // Transactional emails referencing this referral (e.g. sponsor reward).
  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fundId, status])
  @@index([sponsorId])
}

enum ReferralStatus {
  PENDING // referee signed up, hasn't activated yet
  ACTIVATED // referee activated, sponsor rewarded (or reward in flight)
}

// Join between BankTransaction and TokenOperation. Explicit (rather than
// implicit M:N) so we can record `attributedAmount` later if we need split
// accounting (e.g. a deposit's surplus carrying over to a future mint).
model TokenOperationSource {
  id String @id @default(cuid())

  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  tokenOperationId String
  tokenOperation   TokenOperation @relation(fields: [tokenOperationId], references: [id], onDelete: Cascade)

  // How much of the bank transaction this op claims. NULL = the full amount.
  attributedAmount Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([bankTransactionId, tokenOperationId])
  @@index([tokenOperationId])
}

// =============================================================================
// Transactional email (Resend)
// =============================================================================
// Templates live in code under services/email/templates/*.tsx (React Email).
// This table is the outbox/log: every send attempt creates a row keyed by
// `idempotencyKey` so re-runs of a triggering cron don't double-send.
//
// Lifecycle: QUEUED → SENT / FAILED. The row is written in QUEUED before
// calling Resend; after the API response we update with the message ID or
// the error. Retries pick up rows still in QUEUED (process crashed mid-send)
// or in FAILED. Resend webhooks for delivery/open tracking aren't modelled
// here — add a sibling table when reporting actually needs them.

model Email {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  type    EmailType
  toEmail String

  // Optional recipient links — at most one of these is set per email.
  memberId   String?
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  // Context references — what the email is about.
  bankTransactionId  String?
  bankTransaction    BankTransaction?  @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  tokenOperationId   String?
  tokenOperation     TokenOperation?   @relation(fields: [tokenOperationId], references: [id], onDelete: SetNull)
  allocationPeriodId String?
  allocationPeriod   AllocationPeriod? @relation(fields: [allocationPeriodId], references: [id], onDelete: SetNull)
  referralId         String?
  referral           Referral?         @relation(fields: [referralId], references: [id], onDelete: SetNull)
  cardId             String?
  card               Card?             @relation(fields: [cardId], references: [id], onDelete: SetNull)

  // Idempotency key prevents double-queueing on cron re-runs. App composes
  // it from the type + context entity IDs (e.g.
  // "PAYMENT_REMINDER_FIRST:period:<id>:member:<id>").
  idempotencyKey String @unique

  // Resend message ID — populated after successful send. Lets us query
  // Resend's API for delivery status when investigating.
  resendMessageId String? @unique

  status EmailStatus @default(QUEUED)

  // Snapshot of what we sent. Body fields are nullable so a retention job
  // can clear them on older rows; subject stays for quick log browsing.
  subject  String
  bodyHtml String?
  bodyText String?

  errorMessage String?

  queuedAt DateTime  @default(now())
  sentAt   DateTime?
  failedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fundId, type, sentAt])
  @@index([memberId])
  @@index([merchantId])
  @@index([cardId])
  @@index([status])
}

// Per-fund override of an email's wording. Absence of a row for a (fund, type)
// pair = use the built-in i18n default (messages/*.json); a row replaces the
// default subject/body for that fund. Bodies use {placeholder} tokens
// interpolated at send time — the allowed set per type lives in
// services/email/template-config.ts and is validated on save. Only
// ALLOCATION_CONFIRMATION is wired today; the model is type-generic so more
// templates can be made editable without a schema change.
model EmailTemplate {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  type     EmailType
  subject  String
  bodyText String // plain-text body / text-MIME part (derived from bodyHtml when an HTML body is authored)
  bodyHtml String? // rich-HTML body, injected into the branded shell; null = use bodyText as plain text
  ctaLabel String? // for templates that render a CTA button (unused by ALLOCATION_CONFIRMATION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, type])
}

// Per-fund override of a printable document's wording (e.g. the card
// onboarding letter rendered to PDF). One row per (fund, type); absence = use
// the built-in default. Type-generic so more documents can be made editable
// without DDL. The body is markdown-ish text with {{token}} placeholders;
// services/document/pdf.tsx renders it to PDF via @react-pdf/renderer.
model DocumentTemplate {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  type DocumentType
  body String // markdown-ish body with {{token}} placeholders

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, type])
}

enum DocumentType {
  CARD_ONBOARDING_LETTER
}

enum EmailType {
  // Doc 5.3.6 series
  PAYMENT_REMINDER_FIRST
  PAYMENT_REMINDER_SECOND
  PAYMENT_CONFIRMATION
  ALLOCATION_CONFIRMATION
  PAYMENT_FORGOTTEN

  // Useful additions — new values are cheap migrations
  MEMBER_EMAIL_VERIFICATION
  MEMBER_WELCOME
  MEMBER_INVITED
  MEMBER_ACTIVATED
  FUND_INVITED
  MERCHANT_EMAIL_VERIFICATION
  MERCHANT_WELCOME
  MERCHANT_APPROVED
  MERCHANT_REJECTED
  REFERRAL_BONUS_AWARDED
  CARD_ASSIGNED
}

enum EmailStatus {
  QUEUED // row exists, send not confirmed yet
  SENT // Resend accepted; resendMessageId populated
  FAILED // Resend rejected or network failure; errorMessage populated
}

// Public waitlist signups from the marketing landing. Self-serve account
// creation is closed — visitors leave their email here and we invite them
// out of band. Intentionally no FK to User/Fund: these are pre-account leads.
model WaitlistEntry {
  id String @id @default(cuid())

  // Stored lowercased. Unique so a repeat submit updates the existing row
  // instead of piling up duplicates.
  email String @unique

  // Optional free text — what they'd call their fund / why they're interested.
  fundName String?

  // Locale captured at submit time so a follow-up email matches their language.
  locale String?

  status WaitlistStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

enum WaitlistStatus {
  PENDING // signed up, not yet contacted
  INVITED // we've sent them an invite to create an account
  CONVERTED // they created an account
  DECLINED // not a fit / opted out
}
