# =============================================================================
# App
# =============================================================================
# Apex domain (no protocol, no subdomain). The proxy combines this with the
# subdomain part (e.g. "acme") to construct the canonical fund domain on
# create. Use "localhost" in dev — modern browsers resolve `*.localhost` to
# 127.0.0.1 automatically, so visiting `acme.localhost:3000` Just Works.
APP_DOMAIN="localhost"

# Public mirror of APP_DOMAIN — needed by client components that render the
# apex suffix in forms (e.g. ".lacaisse.eu" next to the subdomain input).
NEXT_PUBLIC_APP_DOMAIN="localhost"

# =============================================================================
# Better Auth
# =============================================================================
# Long random secret used to sign session cookies, password reset tokens,
# etc. NEVER share or commit. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# =============================================================================
# Database (Prisma against Supabase Postgres)
# =============================================================================
# Pooled connection (Supavisor, transaction mode) — used by PrismaClient at
# runtime via @prisma/adapter-pg. Get this from Supabase dashboard
# → Project Settings → Database → "Transaction" pooler.
DATABASE_URL="postgresql://..."

# Direct connection (port 5432) — used by Prisma CLI for migrations,
# introspection, and `prisma studio`. Get this from Supabase dashboard
# → Project Settings → Database → "Direct connection".
DIRECT_URL="postgresql://..."

# =============================================================================
# Email (Resend)
# =============================================================================
# All transactional sends — including Better Auth's password-reset and
# (future) email-verification emails — go through services/email/resend.ts.
# No SMTP dashboard config needed.

RESEND_API_KEY=""
EMAIL_FROM="La Caisse <noreply@lacaisse.eu>"

# =============================================================================
# Citizen Pay
# =============================================================================
# Public URL the approval email sends to merchants so they can connect their
# business with Citizen Pay. Single platform-wide URL (CP is one partner).
# Leave blank in dev — the approval email falls back to "the admin will be
# in touch" wording.
CITIZENPAY_MERCHANT_ONBOARDING_URL=""

# CitizenPay Treasury API base URL. When set, the CitizenPay client
# (services/citizenpay/client.ts) talks to the real API and EVERY fund must
# have its own API credentials populated (citizenPayApiKeyId +
# citizenPayApiKeyEnc on the Fund row). Leave blank in dev to fall back to
# the in-process mock that logs each call and returns plausible data.
CITIZENPAY_API_BASE_URL=""           # e.g. https://api2.citizenpay.xyz

# CP `chain_prefix` pre-filled on CP's treasury-registration page when a fund
# admin clicks "Register on Citizen Pay" (services/citizenpay/register-prefill.ts).
# Defaults to "100" (the Gnosis row's chain_prefix in production; the dashboard
# falls back to the virtual chain on an unknown prefix, so it must match
# exactly). Only set it for an api whose chains table is keyed differently. CP must also allowlist this app's fund hosts in its
# TREASURY_REGISTER_ALLOWED_DOMAINS (`*.lacaisse.eu` in prod, `*.localhost:3000`
# in dev) or both handoff routes fail before the user reaches CP.
# CITIZENPAY_REGISTER_CHAIN="100"

# Citizen Pay dashboard — where a fund's treasury business connects its bank
# (open banking) and reads its invoices. The fund-setup checklist links there
# (services/fund-setup/citizenpay-dashboard.ts). Default: https://my.citizenpay.xyz
# CITIZENPAY_DASHBOARD_URL="https://my.citizenpay.xyz"

# Mailbox that receives "subscription accepted" notices from fund owners
# (Settings → Subscription), so Citizen Pay's billing can open the fund's
# billing account and start the La Caisse hosting item. Unset = logged only.
PLATFORM_BILLING_EMAIL=""

# CitizenPay 4337 bundler/paymaster service root. Used by
# services/token/userop.ts to (a) check smart-account deployment via
# `GET /v1/{chainId}/accounts/{sender}/exists`, (b) request paymaster
# sponsorship via `POST /v1/{chainId}/rpc/{pm_address}` with
# `pm_ooSponsorUserOperation`, and (c) submit user-ops via
# `eth_sendUserOperation` on the same endpoint. Must be the *root* URL —
# chainId and paymaster address are appended at call time.
#
# The 4337 stack identity (entrypoint / account-factory / paymaster
# address / paymaster type) is NOT configured here — CP returns it per
# treasury on `GET /v2/treasury` and we cache it on the Fund row (see
# services/citizenpay/sync.ts).
CITIZENPAY_BUNDLER_URL=""            # e.g. https://bundler.citizenpay.xyz

# 
# Member login (plan "Bread card-holder voting", PR W-1)
# 
# The Citizen Pay card wallet (tap.citizenpay.eu) logs fund MEMBERS in through
# this app's OAuth 2.1 server as the static confidential client
# `citizenpay-wallet` (services/auth/oauth-provider-config.ts). The wallet
# holds the same secret; this app stores its SHA-256 on the OauthClient row
# (written at the first /oauth2/authorize or /oauth2/token hit after a boot,
# or by `npx tsx scripts/register-wallet-client.ts`). Rotating the value here
# re-hashes the row on the next boot. Generate with: openssl rand -base64 32
# Leave both blank and the wallet client is simply not registered (MCP is
# unaffected; funds can still turn member login on for the pages alone).
WALLET_OAUTH_CLIENT_SECRET
# RFC 8707 resource = the `aud` of every wallet access token: the Citizen Pay
# api's URL, exactly as the api configures its MEMBER_AUTH_AUDIENCE
# (production: https://api2.citizenpay.xyz).
CITIZENPAY_API_AUDIENCE
# Optional, comma-separated: replaces the default redirect URIs
# (https://tap.citizenpay.eu/auth/callback, https://tap.citizenpay.xyz/auth/callback,
# http://localhost:3000/auth/callback — loopback matches any port).
# WALLET_OAUTH_REDIRECT_URIS

# =============================================================================
# Alchemy
# =============================================================================
# Used for read-side token operations on Gnosis (RPC + Token API for
# balances + Transfers API for history + on-chain MINTER_ROLE verification).
# Alchemy AA / paymaster is NOT used — mint/burn UserOps go through
# CitizenPay's bundler (CITIZENPAY_BUNDLER_URL above) because Alchemy
# doesn't support gas sponsorship on Gnosis.
ALCHEMY_API_KEY=""

# =============================================================================
# At-rest encryption
# =============================================================================
# Symmetric key used to encrypt secrets stored in Prisma rows (CitizenPay
# API keys, token-minter EOA private keys, etc.) via AES-256-GCM. See
# services/crypto/secret.ts. 32 raw bytes encoded as 64 hex characters.
# Generate with:
#   openssl rand -hex 32
# Required whenever any feature stores encrypted secrets. Also the HMAC key
# of member unsubscribe links (services/member/unsubscribe.ts) and the seal
# of short-lived conversion tickets (services/convert/engine.ts).
APP_CRED_KEY=""

# Rotation, zero downtime. The app encrypts with APP_CRED_KEY and decrypts
# with APP_CRED_KEY first, then APP_CRED_KEY_PREVIOUS when set (same format);
# unsubscribe links verify under either key. Recipe:
#   1. openssl rand -hex 32                       → the new key
#   2. Set APP_CRED_KEY=<new>, APP_CRED_KEY_PREVIOUS=<old>; deploy.
#   3. DATABASE_URL=… APP_CRED_KEY=<new> APP_CRED_KEY_PREVIOUS=<old> #        npx tsx scripts/rotate-app-cred-key.ts            # dry run
#        npx tsx scripts/rotate-app-cred-key.ts --apply    # re-encrypts rows
#   4. Dry run again: every column reports 0 to migrate / 0 failed.
#   5. Remove APP_CRED_KEY_PREVIOUS; deploy. (Unsubscribe links sent before
#      the rotation stop verifying at this point — keep the previous key as
#      long as old emails should stay actionable.)
# Leave empty outside a rotation.
APP_CRED_KEY_PREVIOUS=""

# =============================================================================
# Vercel cron
# =============================================================================
# Shared secret Vercel injects on cron-triggered requests as
# `Authorization: Bearer ${CRON_SECRET}`. Cron routes (e.g. the AuthExchange
# cleanup at app/api/cron/auth-exchange-cleanup) verify this so the endpoints
# aren't reachable as anonymous "delete things" handles. Generate with:
#   openssl rand -hex 32
# Set in Vercel project env. Leave blank in dev and the routes will allow
# unauthenticated calls, which is fine for local manual testing.
CRON_SECRET=""

# =============================================================================
# Safe multisig (services/safe)
# =============================================================================
# Fund Safes are standard Safe 1.4.1 accounts (no Citizen Pay module) on
# Gnosis. Their transactions are executed with plain `execTransaction` by
# this relayer EOA, which pays the gas in xDAI. It holds NO authority over
# the Safes (it can only broadcast transactions already carrying the owners'
# N-of-M signatures). Generate with `openssl rand -hex 32` and fund the
# address with a few xDAI (a Safe execution costs well under 0.001 xDAI).
# Unset → Safe pages render but create / execute actions report
# "relayer not configured".
SAFE_RELAYER_PRIVATE_KEY=""
# Safe Transaction Service key (https://developer.safe.global → API Keys),
# used to mirror proposals and confirmations so external owners can sign in
# Safe{Wallet}. Optional: without it the mirror is skipped and reads fall
# back to the low unauthenticated quota.
SAFE_API_KEY=""
# Override the Transaction Service base (default: Gnosis hosted service,
# https://api.safe.global/tx-service/gno/api).
SAFE_TX_SERVICE_URL=""

# =============================================================================
# Token conversions (services/convert)
# =============================================================================
# Swaps between tokens a fund shows (EURe ↔ BREAD) go through CoW Protocol
# pre-sign orders owned by the fund's Safe. Override the orderbook base
# (default: the hosted one for the chain, https://api.cow.fi/xdai) — a mock
# in dev, or a self-hosted orderbook.
COW_API_URL=""
