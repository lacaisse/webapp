# =============================================================================
# App
# =============================================================================
# Apex domain (no protocol, no subdomain). The proxy combines this with the
# subdomain part (e.g. "acme") to construct the canonical fund domain on
# create. Use "localhost" in dev — modern browsers resolve `*.localhost` to
# 127.0.0.1 automatically, so visiting `acme.localhost:3000` Just Works.
APP_DOMAIN="localhost"

# Public mirror of APP_DOMAIN — needed by client components that render the
# apex suffix in forms (e.g. ".lacaisse.eu" next to the subdomain input).
NEXT_PUBLIC_APP_DOMAIN="localhost"

# =============================================================================
# Better Auth
# =============================================================================
# Long random secret used to sign session cookies, password reset tokens,
# etc. NEVER share or commit. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# =============================================================================
# Database (Prisma against Supabase Postgres)
# =============================================================================
# Pooled connection (Supavisor, transaction mode) — used by PrismaClient at
# runtime via @prisma/adapter-pg. Get this from Supabase dashboard
# → Project Settings → Database → "Transaction" pooler.
DATABASE_URL="postgresql://..."

# Direct connection (port 5432) — used by Prisma CLI for migrations,
# introspection, and `prisma studio`. Get this from Supabase dashboard
# → Project Settings → Database → "Direct connection".
DIRECT_URL="postgresql://..."

# =============================================================================
# Email (Resend)
# =============================================================================
# All transactional sends — including Better Auth's password-reset and
# (future) email-verification emails — go through services/email/resend.ts.
# No SMTP dashboard config needed.

RESEND_API_KEY=""
EMAIL_FROM="La Caisse <noreply@lacaisse.eu>"

# =============================================================================
# Citizen Pay
# =============================================================================
# Public URL the approval email sends to merchants so they can connect their
# business with Citizen Pay. Single platform-wide URL (CP is one partner).
# Leave blank in dev — the approval email falls back to "the admin will be
# in touch" wording.
CITIZENPAY_MERCHANT_ONBOARDING_URL=""

# =============================================================================
# Vercel cron
# =============================================================================
# Shared secret Vercel injects on cron-triggered requests as
# `Authorization: Bearer ${CRON_SECRET}`. Cron routes (e.g. the AuthExchange
# cleanup at app/api/cron/auth-exchange-cleanup) verify this so the endpoints
# aren't reachable as anonymous "delete things" handles. Generate with:
#   openssl rand -hex 32
# Set in Vercel project env. Leave blank in dev and the routes will allow
# unauthenticated calls, which is fine for local manual testing.
CRON_SECRET=""
