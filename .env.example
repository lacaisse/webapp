# =============================================================================
# Supabase
# =============================================================================
# Project URL and anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role key — server-only. Never expose. Currently unused (auth is via
# anon key + cookies); add only if a server action needs admin-level Supabase
# operations (e.g. setting `app_metadata.role` on a user).
# SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# Database (Prisma against Supabase Postgres)
# =============================================================================
# Pooled connection (Supavisor, transaction mode) — used by PrismaClient at
# runtime via @prisma/adapter-pg. Get this from Supabase dashboard
# → Project Settings → Database → "Transaction" pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Direct connection (port 5432) — used by Prisma CLI for migrations,
# introspection, and `prisma studio`. Get this from Supabase dashboard
# → Project Settings → Database → "Direct connection".
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
